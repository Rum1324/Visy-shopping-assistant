# Server-only secrets. Copy to apps/server/.env. Never put these in the extension.
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2
JEV_API_KEY=
JEV_BASE_URL=
JEV_THRESHOLD=0.8
APIFY_TOKEN=
# Moss: portal at moss.dev → create project (redeem CALHACKS on the billing page)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Navigator picker chain (apps/server/src/navigator). Tune MOSS_GAP with `npm run bench -w @visy/server`.
PICKER_CHAIN=memory,moss,claude
MOSS_GAP=0.1
MOSS_ALPHA=0.2
MOSS_PREFILTER=30
CLAUDE_PICKER_MODEL=claude-haiku-5-5
CLAUDE_PICKER_EFFORT=low
CLAUDE_PICKER_THINKING=off

# Where the extension connects
PORT=8787
# amazon = real Amazon via Playwright. Target and Walmart stay on fixtures. Leave unset for all fixtures.
NAV=
# convex = real preference rows. Leave PREFS unset to use the fixture profile.
# From apps/server: npx convex dev, then paste the deployment URL.
CONVEX_URL=
PREFS=
